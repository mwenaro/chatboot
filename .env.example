# FREE AI Configuration (Optional)
# The app works without any API keys using free Hugging Face models
# Add API keys below for enhanced AI capabilities

# Hugging Face (Free tier: 1000 requests/month)
# Get free API key at: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_token_here

# OpenAI (Paid but powerful - uncomment to use)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Free tier: 15 requests/minute)
# Get free API key at: https://makersuite.google.com/app/apikey
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Anthropic Claude (Paid)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere (Free tier available)
# COHERE_API_KEY=your_cohere_api_key_here
